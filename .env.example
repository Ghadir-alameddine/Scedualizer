# Environment variables for Scedualizer.
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/scedualizer

# --- Auth / JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=8

# --- Deployment mode ---
# true  = single-tenant self-hosted mode (no tenant_id RLS scoping required)
# false = SaaS multi-tenant mode (RLS tenant scoping enforced)
SELF_HOSTED=false
